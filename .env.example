# Dera Darko Trade — environment template. PLACEHOLDERS ONLY. Never commit real values.
# SERVER-ONLY secrets (set with `wrangler secret put <NAME>`; never prefix with VITE_):
ADMIN_BOOTSTRAP_REF_HASH=   # SHA-256 hex of the owner's enrolment reference (see scripts/hash-bootstrap-ref.ts)
ADMIN_PORTAL_PATH=          # non-obvious mount path, >=12 chars, [a-z0-9-], must NOT contain "admin"
SESSION_SECRET=             # >=32 random bytes, used to sign session tokens
PAYMENT_PROVIDER=           # "paystack" is implemented; others need an adapter in src/lib/payments/provider.ts (only after merchant eligibility is confirmed)
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
EMAIL_API_KEY=              # Resend API key (https://resend.com); without it no email is sent
EMAIL_FROM=                 # e.g. "Dera Darko Trade <no-reply@your-verified-domain>" (domain must be verified with the provider)
SMS_PROVIDER_API_KEY=
# PUBLIC (safe in the browser):
VITE_SITE_URL=https://example.com
