{
  // Starting point only: copy to wrangler.jsonc and adapt to the Worker output of your build. Secrets are NOT stored here —
  // set them with `wrangler secret put <NAME>` (see docs/DEPLOYMENT.md section 3).
  "name": "dera-darko-trade",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "SITE_ORIGIN": "https://your-domain.example",
    "EXCHANGE_RATE_GHS_PER_USD": "11.47",
    "EXCHANGE_RATE_SOURCE": "Owner-set rate",
    "EXCHANGE_RATE_DATE": "2026-10-31"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "dera-darko-trade", "database_id": "<paste the id printed by `wrangler d1 create`>" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "dera-darko-trade-media" }
  ],
  "triggers": { "crons": ["*/5 * * * *"] }
}
